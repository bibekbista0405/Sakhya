PORT=4000
NODE_ENV=development
# Must be a long random string (32+ characters) — required in production, the
# server refuses to start without one. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
DB_PATH=./data/sakhya.db

# Phase 4: encrypted attachments. The server only ever stores ciphertext —
# see server/src/routes/attachments.ts for why it can't validate file
# contents the way a normal (non-E2EE) upload endpoint would.
ATTACHMENTS_DIR=./data/attachments
MAX_ATTACHMENT_MB=25
